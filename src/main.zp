import "cli";
import "util";

import "std/fs";
import "std/string";

import "std/io" { eprint, eprintln };
import "std/collection" { HashMap };

import "template" { substitute };

fun readInput(file: String) String {
  var result: String;
  if file == "-" || string.len(file) == 0 {
    result = util.readFromStdin();
  } else {
    result = fs.readFile(file) or err {
      eprint("failed to read input from ");
      eprintln(file);
      return "";
    };
  }

  return result;
}

fun saveOutput(file: String, content: String) Bool {
  if file == "-" || string.len(file) == 0 {
    print(content);
    return true;
  }

  fs.writeFile(file, content) or err {
    return false;
  };
  return true;
}

fun main() Int {
  var map = new HashMap<String>();
  var args = cli.parse(ref map) or err {
    return 2;
  };

  var input = readInput(args.input);
  var output = substitute(input, ref map, args.undefVarBehavior) or err {
    return 1;
  };

  saveOutput(args.output, output);
  return 0;
}
