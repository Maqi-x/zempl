import "std/fs";
import "std/string";
import "std/collection";

pub fun load(file: String, ref map: HashMap<String>) Bool {
  var content: String = fs.readFile(file) or err {
    return false;
  };

  if string.len(content) == 0 {
    eprintln("warning: file is empty");
    return true;
  }

  var i: Int = 0;
  var n: Int = string.len(content);
  while i < n {
    var keyStart: Int = i;
    while i < n && content[i] != '=' && content[i] != '\n' {
      i++;
    }
    var keyEnd: Int = i;

    if i < n && content[i] == '=' {
      i++;
    }

    var valueStart: Int = i;
    while i < n && content[i] != '\n' {
      i++;
    }
    var valueEnd: Int = i;

    if i < n && content[i] == '\n' {
      i++;
    }

    var key: String = string.slice(content, keyStart, keyEnd - keyStart);
    var value: String = string.slice(content, valueStart, valueEnd - valueStart);
    map.put(key, value);
  }

  // memory leak is intentional
  //freeFileContent(content);
  return true;
}
